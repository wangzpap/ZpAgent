# 环境变量配置文件
# 将此文件复制为 .env 并填入 API_KEY

# ===== LLM API 配置 =====
# DeepSeek API（兼容 OpenAI 格式）
API_KEY=your-api-key-here
BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-v4-flash
TEMPERATURE=0.7
MAX_COMPLETION_TOKENS=2048
REQUEST_TIMEOUT=60
MAX_RETRIES=2

# ===== Agent 配置 =====
# ReAct 最大迭代次数（防止无限循环）
MAX_ITERATIONS=10

# ===== 对话压缩（摘要中间件）配置 =====
# 长对话历史 token 超过阈值时，自动将早期消息压缩为摘要，保留主线、减少上下文占用
# 全局生效（所有会话），可从前端设置弹窗"对话压缩"板块修改
# 是否启用摘要压缩中间件（false 表示不启用）
SUMMARY_ENABLED=false
# 摘要专用模型名称（留空表示复用主模型 MODEL_NAME，可用更轻量的模型专门做摘要）
SUMMARY_MODEL=
# 触发摘要的 token 阈值（历史消息 token 总量超过此值时触发压缩）
SUMMARY_MAX_TOKENS=4000
# 摘要后保留最近的消息条数（更早的消息被压缩为摘要文本）
SUMMARY_MESSAGES_TO_KEEP=20

# ===== 服务配置 =====
HOST=0.0.0.0
PORT=8000

# ===== 对话检查点存储后端（策略模式） =====
# 可选值: memory（内存，默认，开发用） | mysql（MySQL 持久化，生产用）
CHECKPOINT_BACKEND=memory
# ===== 会话元数据存储后端（策略模式） ，建议与CHECKPOINT_BACKEND一致=====
# 可选值: memory（内存，默认，开发用） | mysql（MySQL 持久化，生产用）
CONVERSATION_BACKEND=memory

# ===== MySQL 配置（CONVERSATION_BACKEND=mysql 或 CHECKPOINT_BACKEND=mysql 时共用） =====
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=zpagent
